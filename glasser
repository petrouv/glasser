# ─── Splash ───────────────────────────────────────────────────────────────
# Banner above the cards (GLASSER_BANNER). On a large enough screen — a
# drawing of a lens with a distance scale and an f/1.2–16 aperture ring,
# else one line "◉  glasser  ·  …". The drawing only in card mode: a redraw
# prints the banner again, and outside cards 7 extra lines in the log are
# pointless. NO_COLOR (no-color.org) — drawing without color. --no-art (or
# GLASSER_NO_ART=1) turns all styling off: a line instead of the drawing, no
# scanning spinner and no "shutter click".

BANNER_ROWS=3           # height of GLASSER_BANNER in screen lines
BANNER_MIN_ROWS=30      # fewer — the drawing would take space from the menu
BANNER_MIN_COLS=66      # drawing with margins (30) + a 35-column caption
BANNER_ART_W=23         # inner width of the frame
BANNER_MAX_AP=1.2       # aperture ring of the drawing: max aperture…
BANNER_MIN_AP=16        # …and min aperture
NO_ART=${GLASSER_NO_ART:-0}
# Aperture frames: the scanning spinner and the "shutter click".
APERTURE_FRAMES=("·" "○" "◎" "◉" "◎" "○")

# f-number in hundredths: "2.8" → 280, "16" → 1600 (bash has no fractions).
_fnum_x100() {
    local i=${1%%.*} f=0
    [[ "$1" == *.* ]] && f=${1#*.}
    f="${f}00"
    FNUM_X100=$(( 10#${i:-0} * 100 + 10#${f:0:2} ))
}

# Color of a digit on the aperture ring: muted tones of the 256-color
# palette, readable on light and dark backgrounds. Max aperture: text color.
_banner_stop_color() {
    case "$1" in
        2)   STOP_COLOR=167 ;; 2.8) STOP_COLOR=166 ;; 4)  STOP_COLOR=172 ;;
        5.6) STOP_COLOR=136 ;; 8)   STOP_COLOR=30  ;; 11) STOP_COLOR=28  ;;
        16)  STOP_COLOR=31  ;; 22)  STOP_COLOR=61  ;; 32) STOP_COLOR=96  ;;
        *)   STOP_COLOR="" ;;
    esac
}

# Total length of the digits in stops → len. Both variables are locals of
# the caller _banner_aperture_row (bash dynamic scoping).
_banner_stops_len() {
    local k
    len=0
    for k in "${stops[@]}"; do len=$((len + ${#k})); done
}

# Aperture ring row exactly BANNER_ART_W columns wide: from the most closed
# on the left to the max aperture on the right, as on a lens. $1 — max
# aperture, $2 — min aperture, $3 — 1: colored digits. Result in BANNER_APER.
_banner_aperture_row() {
    local max_ap="$1" min_ap="$2" color="$3" s v mx mn i n len extra base rem used lpad rpad
    local stops=() out="" k
    _fnum_x100 "$max_ap"; mx=$FNUM_X100
    _fnum_x100 "$min_ap"; mn=$FNUM_X100
    stops=("$max_ap")
    for s in 1.4 2 2.8 4 5.6 8 11 16 22 32; do
        _fnum_x100 "$s"; v=$FNUM_X100
        # 5%: f/1.9 does not sit next to 2, and f/2 is not duplicated.
        (( v * 100 > mx * 105 && v <= mn )) && stops+=("$s")
    done
    # Does not fit — as on fast lenses: first drop the stop right after
    # the max aperture (f/1.2 → "… 2 1.2"), then the most closed ones.
    _banner_stops_len
    if (( len + ${#stops[@]} - 1 > BANNER_ART_W && ${#stops[@]} > 2 )); then
        stops=("${stops[0]}" "${stops[@]:2}")
        _banner_stops_len
    fi
    while (( len + ${#stops[@]} - 1 > BANNER_ART_W && ${#stops[@]} > 1 )); do
        stops=("${stops[@]:0:${#stops[@]}-1}")
        _banner_stops_len
    done
    # Spaces between digits (at most 3), the rest split evenly at the edges.
    n=${#stops[@]}
    extra=$((BANNER_ART_W - len)); base=0; rem=0
    if (( n > 1 )); then
        base=$((extra / (n - 1)))
        if (( base >= 3 )); then base=3; rem=0
        else rem=$((extra - base * (n - 1))); fi
        used=$((len + base * (n - 1) + rem))
    else
        used=$len
    fi
    lpad=$(((BANNER_ART_W - used) / 2)); rpad=$((BANNER_ART_W - used - lpad))
    printf -v out '%*s' "$lpad" ''
    for ((i = n - 1; i >= 0; i--)); do
        STOP_COLOR=""
        [[ "$color" == 1 ]] && _banner_stop_color "${stops[$i]}"
        if [[ -n "$STOP_COLOR" ]]; then
            out+=$'\033[38;5;'"${STOP_COLOR}m${stops[$i]}"$'\033[0m'
        else
            out+="${stops[$i]}"
        fi
        if (( i > 0 )); then
            printf -v s '%*s' "$base" ''
            out+="$s"
            # Spread the extra spaces evenly (Bresenham).
            k=$((n - 1 - i))
            (( (k + 1) * rem / (n - 1) > k * rem / (n - 1) )) && out+=" "
        fi
    done
    printf -v s '%*s' "$rpad" ''
    BANNER_APER="$out$s"
}

# Spinner until the first exiftool progress line (folder walk, Perl start):
# spins the aperture in the "Scanning…" line via stderr. Runs in background;
# exits by itself if glasser died (kill -0 $$), so as not to write to someone
# else's terminal. Stopped by _stop_scan_spinner.
_scan_spinner() {
    local i=0
    while kill -0 $$ 2>/dev/null; do
        tprintf '%s%s Scanning…' "$ANSI_ERASE_LINE" \
               "${APERTURE_FRAMES[i % ${#APERTURE_FRAMES[@]}]}" >&2
        i=$((i + 1))
        sleep 0.12
    done
}

# Stops the spinner (PID in SPINNER_PID) and erases its line.
SPINNER_PID=""
_stop_scan_spinner() {
    [[ -n "$SPINNER_PID" ]] || return 0
    kill "$SPINNER_PID" 2>/dev/null || true
    wait "$SPINNER_PID" 2>/dev/null || true
    SPINNER_PID=""
    trap - INT
    printf '%s' "$ANSI_ERASE_LINE" >&2
}

# "Shutter click" before "✓ Done.": the aperture closes and
# opens (~0.3 s) in place of the check mark. Terminal only, no --no-art.
shutter_click() {
    local f
    [[ -t 1 && -n "${TERM:-}" && "${TERM:-}" != "dumb" && "$NO_ART" != 1 ]] || return 0
    for f in "◉" "◎" "○" "·" " " "·" "○" "◎" "◉"; do
        printf '\r%s' "$f"
        sleep 0.035
    done
    printf '\r'
}

# Truncates $1 to $2 characters (with "…"). Result in FIT.
_fit() {
    FIT="$1"
    if (( $2 <= 0 )); then FIT=""
    elif (( ${#1} > $2 )); then FIT="${1:0:$2-1}…"; fi
}

# Builds GLASSER_BANNER and BANNER_ROWS. $1 — folder, $2 — "N files"
# (empty — scanning in progress), $3 — "M groups" (empty — one group).
make_banner() {
    local folder="$1" files="${2:-}" groups="${3:-}" info
    local B="" D="" R="" RED="" color=1 w knurl i
    _term_size
    if [[ $USE_CARDS -ne 1 || "$NO_ART" == 1 ]] \
       || (( TERM_ROWS < BANNER_MIN_ROWS || TERM_COLS < BANNER_MIN_COLS )); then
        if [[ -z "$files" ]]; then
            GLASSER_BANNER=$'\n◉  glasser\n\n'
        else
            GLASSER_BANNER=$'\n'"◉  glasser  ·  $folder  ·  $files${groups:+  ·  $groups}"$'\n\n'
        fi
        BANNER_ROWS=3
        return 0
    fi
    if [[ -z "${NO_COLOR:-}" ]]; then
        B=$'\033[1m'; D=$'\033[2m'; R=$'\033[0m'; RED=$'\033[38;5;160m'
    else
        color=0
    fi
    _banner_aperture_row "$BANNER_MAX_AP" "$BANNER_MIN_AP" "$color"
    knurl=""
    for ((i = 0; i < BANNER_ART_W - 2; i++)); do
        if (( i % 2 )); then knurl+="▒"; else knurl+="░"; fi
    done
    if [[ -z "$files" ]]; then
        _t 'scanning…'
        info="$folder · $T"
    else
        info="$folder · $files${groups:+ · $groups}"
    fi
    w=$((TERM_COLS - 31))   # 30 — margin, frame and caption gap, 1 — edge
    local t1 t2 t3
    _fit "glasser" "$w";                          t1=$FIT
    _t 'EXIF for manual lenses'
    _fit "$T" "$w";                               t2=$FIT
    _fit "$info" $((w - 2));                      t3=$FIT
    GLASSER_BANNER=$'\n'
    GLASSER_BANNER+="    ∞   5   3   2  1.5  1m"$'\n'
    GLASSER_BANNER+="  ${D}╭─┴───┴───┴───┴───┴───┴─╮${R}   ${B}${t1}${R}"$'\n'
    GLASSER_BANNER+="  ${D}│ ${knurl} │${R}   ${D}${t2}${R}"$'\n'
    GLASSER_BANNER+="  ${D}│${R}${BANNER_APER}${D}│${R}   ${RED}◉${R} ${t3}"$'\n'
    GLASSER_BANNER+="  ${D}╰───────────────────────╯${R}"$'\n\n'
    BANNER_ROWS=7
}

# ─── Main ─────────────────────────────────────────────────────────────────

EXIFTOOL_ARGS=()
CAM_IDX=-1
LENS_IDX=-1
VERBOSE_PROGRESS=0

# Commit-phase results (by group index):
#   GROUP_RESULT_CAM[g]    — camera index in the database (or -1 if skip);
#   GROUP_RESULT_LENS[g]   — lens index in the database (or -1);
#   GROUP_RESULT_STATUS[g] — "commit" | "skip"; after writing "failed"
#                            if exiftool returned an error on the group.
GROUP_RESULT_CAM=()
GROUP_RESULT_LENS=()
GROUP_RESULT_STATUS=()

main() {
    local folder=""
    local dry_run=0
    local no_confirm=0
    local forced_camera=""
    local forced_lens=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)         print_help; return 0 ;;
            --version)         printf 'glasser %s\n' "$GLASSER_VERSION"; return 0 ;;
            --list-lenses)     load_lens_db; print_lens_list; return 0 ;;
            --list-cameras)    load_camera_db; print_camera_list; return 0 ;;
            --dry-run)         dry_run=1; shift ;;
            --no-confirm)      no_confirm=1; shift ;;
            --verbose)         VERBOSE_PROGRESS=1; shift ;;
            --no-art)          NO_ART=1; shift ;;
            --camera)
                [[ $# -ge 2 ]] || dief '--camera requires an ID'
                forced_camera="$2"; shift 2 ;;
            --lens)
                [[ $# -ge 2 ]] || dief '--lens requires an ID'
                forced_lens="$2"; shift 2 ;;
            --)
                # After "--" all are positional arguments (POSIX), with the
                # same extra-argument check as without "--".
                shift
                local a
                for a in "$@"; do
                    [[ -z "$folder" ]] || dief 'extra argument: %s' "$a"
                    folder="$a"
                done
                break
                ;;
            -*)
                dief 'unknown option: %s' "$1" ;;
            *)
                [[ -z "$folder" ]] || dief 'extra argument: %s' "$1"
                folder="$1"; shift ;;
        esac
    done

    # Databases after argument parsing: --help works even without lenses.ini.
    load_lens_db
    load_camera_db

    # Check --camera/--lens right away, before clearing the screen and
    # scanning the folder: a typo in an id must not cost a full exiftool pass.
    # -1 — "not set", then process_group guesses by itself.
    local forced_cam_idx=-1 forced_lens_idx=-1
    if [[ -n "$forced_camera" ]]; then
        forced_cam_idx=$(index_of "$forced_camera" ${CAM_IDS[@]+"${CAM_IDS[@]}"})
        [[ $forced_cam_idx -ge 0 ]] || dief 'camera not in the database: %s' "$forced_camera"
    fi
    if [[ -n "$forced_lens" ]]; then
        forced_lens_idx=$(index_of "$forced_lens" ${LENS_IDS[@]+"${LENS_IDS[@]}"})
        [[ $forced_lens_idx -ge 0 ]] || dief 'lens not in the database: %s' "$forced_lens"
    fi

    [[ -z "$folder" ]] && folder="$(pwd)"
    [[ -d "$folder" ]] || dief 'not a folder: %s' "$folder"
    # Absolute path: all scanned paths and -@ argfile lines
    # start with '/'. Otherwise a folder "#roll" is a comment in the argfile,
    # " lead" loses its leading space, exiftool reads "-dash" as an option.
    # No cd: a logical cd would collapse "L/.." lexically (while the OS uses
    # the real folder), and $(...) would strip a trailing newline.
    # Strip trailing "/" and "/." (same place): otherwise for "d//" exiftool
    # returns both "d//sub/x" and "d/x", and the prefix check loses files.
    [[ "$folder" == /* ]] || folder="$PWD/$folder"
    while :; do
        case "$folder" in
            */) folder="${folder%/}" ;;
            */.) folder="${folder%/.}" ;;
            *) break ;;
        esac
    done
    [[ -n "$folder" ]] || folder="/"
    command -v exiftool >/dev/null 2>&1 || dief 'exiftool not found in PATH'

    # Interactive mode without a terminal (cron, CI, pipe) is an error, not
    # "Cancelled" with code 0 like a deliberate q. Checked before scanning.
    # Dry-run without --no-confirm also asks per group, so it does not
    # matter here.
    if [[ $no_confirm -eq 0 ]] && ! { : </dev/tty; } 2>/dev/null; then
        dief 'no terminal — use --no-confirm'
    fi

    # One trial CSI 6n — in this shell, not in a card's $(...): if the
    # terminal does not answer (Emacs shell, script/expect, CI pty), cards
    # are turned off entirely — no clear, no queries and no one-second
    # timeouts on every redraw.
    if [[ $USE_CARDS -eq 1 ]]; then
        get_cursor_row
        [[ $CURSOR_ROW -gt 0 ]] || USE_CARDS=0
    fi
    _card_style_init

    # Soft clear of the visible area before starting (TTY only).
    # Without it, earlier bash/zsh output pushes our "top of card"
    # above the visible area on the first scroll, and cursor-up can no longer
    # get back there → in-place redraw breaks.
    # `\033[H\033[2J` clears the visible part and moves the cursor to (1,1).
    # Scroll-back is KEPT (this is not `\033[3J`) — the user can
    # scroll up and see earlier commands.
    if [[ $USE_CARDS -eq 1 ]]; then
        printf '%s' "$ANSI_CLEAR_SCREEN"
    fi

    # Save the top of the scan phase via CSI 6n. When scanning
    # finishes, erase everything from this position and replace it with the
    # full banner (with the folder and file count).
    local scan_top_row=0
    if [[ $USE_CARDS -eq 1 ]]; then
        get_cursor_row
        scan_top_row=$CURSOR_ROW
        # Banner during scanning — shows that glasser is working.
        make_banner "$(basename "$folder")"
        printf '%s' "$GLASSER_BANNER"
    fi

    # Step 1: one batch command reads the EXIF of all files and groups them.
    scan_and_group "$folder"

    local total=${#FILES_PATH[@]}
    local groups=${#GROUP_SIG[@]}
    if [[ $total -eq 0 ]]; then
        # Everything found was filtered out — without a reason, "no images" is
        # confusing (the skip warning below never gets here).
        if [[ $SCAN_SKIPPED -gt 0 ]]; then
            dief 'no readable images in the folder: %d %s skipped — control characters (newline, TAB) in a file or folder name, or exiftool could not read the file: %s' \
                 "$SCAN_SKIPPED" "$(files_word "$SCAN_SKIPPED")" "$folder"
        fi
        dief 'no images in the folder: %s' "$folder"
    fi

    # In card mode the banner below would erase the preview table at once, so
    # it is not printed at all (it would only clutter scroll-back). Print it
    # when there will be no banner: non-TTY or CSI 6n gave no position.
    local replace_scan=0
    if [[ $USE_CARDS -eq 1 && $scan_top_row -gt 0 ]]; then
        replace_scan=1
    fi
    if [[ $replace_scan -eq 0 ]]; then
        tprintf 'Analyzing: %s\n' "$folder"
        if [[ $groups -eq 1 ]]; then
            tprintf 'Files: %d\n' "$total"
        else
            tprintf 'Files: %d, groups: %d\n\n' "$total" "$groups"
            group_table_widths preview
            group_table_header preview
            local g
            for ((g=0; g<groups; g++)); do
                format_group_line "$g" preview
            done
        fi
    fi

    # In a TTY: replace the whole scan phase with the banner (splash or line
    # "◉ glasser · <folder> · N files [· M groups]", see make_banner).
    # Save the banner — _card_redraw_screen reprints it.
    if [[ $replace_scan -eq 1 ]]; then
        _restore_and_erase "$scan_top_row"
        local groups_str=""
        [[ $groups -eq 1 ]] || groups_str="$groups $(groups_word "$groups")"
        make_banner "$(basename "$folder")" \
                    "$total $(files_word "$total")" "$groups_str"
        printf '%s' "$GLASSER_BANNER"
    fi
    # After the banner: in a TTY everything printed during scanning is erased.
    if [[ $SCAN_SKIPPED -gt 0 ]]; then
        tprintf 'warning: %d %s skipped — control characters (newline, TAB) in a file or folder name, or exiftool could not read the file\n' \
               "$SCAN_SKIPPED" "$(files_word "$SCAN_SKIPPED")" >&2
    fi

    # Step 2: commit phase. Walk the groups; for each one the user
    # confirms the choice (or skips). NO writing happens here.
    local g
    for ((g=0; g<groups; g++)); do
        local rc=0
        process_group "$g" "$groups" "$no_confirm" \
                      "$forced_cam_idx" "$forced_lens_idx" || rc=$?
        case "$rc" in
            0)
                GROUP_RESULT_STATUS+=("commit")
                GROUP_RESULT_CAM+=("$CAM_IDX")
                GROUP_RESULT_LENS+=("$LENS_IDX")
                ;;
            2)
                GROUP_RESULT_STATUS+=("skip")
                GROUP_RESULT_CAM+=("-1")
                GROUP_RESULT_LENS+=("-1")
                ;;
            3)
                tprintf '\nCancelled. Nothing written.\n'
                return 0
                ;;
            4)
                _tty_lost_err
                return 1
                ;;
            *)
                # Validation error in no-confirm mode.
                return 1
                ;;
        esac
    done

    # Step 3: apply phase. Summary plan + final confirmation, then the write.
    apply_plan "$dry_run" "$no_confirm"
}

# Processes one group in the commit phase. Returns:
#   0 — choice confirmed;
#   1 — validation error (no-confirm);
#   2 — skipped (s, or "0" in the menu when there is nowhere to go back);
#   3 — quit (q);
#   4 — EOF (Ctrl-D) or no terminal: reading /dev/tty failed
#       in the middle of interaction.
# Arguments $4/$5 — --camera/--lens indices (main checked them in advance),
# -1 — not set, guess.
# Fills globals CAM_IDX, LENS_IDX (the caller saves them to RESULT arrays).
process_group() {
    local g="$1" total_groups="$2" no_confirm="$3"
    local forced_cam_idx="$4" forced_lens_idx="$5"
    local sig_make sig_model sig_lensmodel sig_focal sig_maxap
    IFS=$SEP read -r sig_make sig_model sig_lensmodel sig_focal sig_maxap \
        <<<"${GROUP_SIG[$g]}"

    # Detect once (does not change during the card — until the user
    # re-picks via the menu). Data comes from the scan (the group's first
    # file), without running exiftool again.
    if [[ $forced_cam_idx -ge 0 ]]; then
        CAM_IDX=$forced_cam_idx
    else
        CAM_IDX=$(detect_camera "$sig_make" "$sig_model")
    fi
    if [[ $forced_lens_idx -ge 0 ]]; then
        LENS_IDX=$forced_lens_idx
        DETECT_LENS_AMBIGUOUS=""
    else
        detect_lens "$sig_focal" "$sig_maxap" "$sig_lensmodel" \
                    "${GROUP_LENSMAKE[$g]}" "${GROUP_LENSINFO[$g]}"
        LENS_IDX=$DETECT_LENS_IDX
    fi

    # ── no-confirm path: no prompts. The card is printed in full and
    # collapses into a log line (in a TTY it is erased, outside a TTY it stays
    # above it); on an error it stays as is. ──
    if [[ $no_confirm -eq 1 ]]; then
        # Episode: blank + 2 summary lines (+ generation and serial in
        # CARD_STYLE) + an error line.
        card_start_with_group_header "$g" "$total_groups" $((4 + CARD_STYLE))
        printf '\n'
        print_summary "guessed"
        if [[ $CAM_IDX -lt 0 ]]; then
            errf 'group %d/%d: camera not detected (need --camera ID)' $((g+1)) "$total_groups"
            return 1
        fi
        if [[ $LENS_IDX -lt 0 && -n "$DETECT_LENS_AMBIGUOUS" ]]; then
            errf 'group %d/%d: lens is ambiguous: %s — need --lens ID' $((g+1)) "$total_groups" "$DETECT_LENS_AMBIGUOUS"
            return 1
        fi
        if [[ $LENS_IDX -lt 0 ]]; then
            errf 'group %d/%d: lens not guessed (need --lens ID)' $((g+1)) "$total_groups"
            return 1
        fi
        _collapse_committed "$g" "$total_groups"
        return 0
    fi

    # ── Interactive path: anchor header + changing sub-episodes. ──
    card_start_with_group_header "$g" "$total_groups"

    local first_iteration=1
    local prev_cam prev_lens new_cam new_lens
    while true; do
        # Episode: summary + prompt. The tag preview moved to the plan view.
        # Redraw the header on every pass except the first.
        if [[ $first_iteration -eq 0 ]]; then
            card_reset_to_header "$SUMMARY_EPISODE_ROWS"
        fi
        local mode="guessed"
        [[ $first_iteration -eq 0 ]] && mode="chosen"

        if [[ $CAM_IDX -ge 0 && $LENS_IDX -ge 0 ]]; then
            printf '\n'
            print_summary "$mode"
            local ans
            ans=$(prompt_confirm)
            case "$ans" in
                yes)
                    _collapse_committed "$g" "$total_groups"
                    return 0
                    ;;
                quit)
                    return 3
                    ;;
                skip)
                    _collapse_skipped "$g" "$total_groups"
                    return 2
                    ;;
                notty)
                    return 4
                    ;;
                no)   ;;
            esac
        fi

        # "0" in the menu: if there was a full choice before the menu — back
        # to "Accept?" with it; otherwise there is nowhere to return (with no
        # prompt the menu would reopen) — skip the group. Only q quits
        # everything.
        prev_cam=$CAM_IDX
        prev_lens=$LENS_IDX
        local cancel_label
        _t 'Skip group'; cancel_label=$T
        if [[ $prev_cam -ge 0 && $prev_lens -ge 0 ]]; then
            _t 'Back'; cancel_label=$T
        fi

        # Episode: camera menu. Erases the previous episode (prompt).
        # A failed substitution or a non-number exits, not a silent index 0.
        _camera_menu_rows
        card_reset_to_header "$MENU_ROWS"
        new_cam=$(prompt_camera "$cancel_label") || return 3
        [[ $new_cam =~ ^-?[0-9]+$ ]] || return 3
        if [[ $new_cam -ge 0 ]]; then
            CAM_IDX=$new_cam
            # Episode: lens menu. Erases the camera menu.
            _lens_menu_rows
            card_reset_to_header "$MENU_ROWS"
            new_lens=$(prompt_lens "$cancel_label") || return 3
            [[ $new_lens =~ ^-?[0-9]+$ ]] || return 3
        else
            new_lens=$new_cam
        fi
        case "$new_lens" in
            -2) return 4 ;;
            -1)
                if [[ $prev_cam -ge 0 && $prev_lens -ge 0 ]]; then
                    CAM_IDX=$prev_cam
                    LENS_IDX=$prev_lens
                    card_reset_to_header
                    continue
                fi
                _collapse_skipped "$g" "$total_groups"
                return 2
                ;;
        esac
        LENS_IDX=$new_lens

        first_iteration=0
    done
}

# Collapses the card into one line "<mark> Group N/M: <body> (K files)".
# The "Group N/M: " prefix only with several groups.
# Arguments: g, total_groups, mark, body.
_collapse_group_line() {
    local g="$1" total_groups="$2" mark="$3" body="$4"
    local count="${GROUP_COUNT[$g]}"
    local word prefix=""
    word=$(files_word "$count")
    if [[ $total_groups -gt 1 ]]; then
        _tv prefix 'Group %d/%d: ' $((g+1)) "$total_groups"
    fi
    card_collapse "${mark} ${prefix}${body} (${count} ${word})"
}

# "✓ Group N/M: cam + lens (K files)" for the current CAM_IDX/LENS_IDX.
_collapse_committed() {
    _collapse_group_line "$1" "$2" "✓" \
        "${CAM_DISPLAYS[$CAM_IDX]} + ${LENS_DISPLAYS[$LENS_IDX]}"
}

# "⤳ Group N/M: skipped (K files)".
_collapse_skipped() {
    _t 'skipped'
    _collapse_group_line "$1" "$2" "⤳" "$T"
}

# Apply phase: the orchestrator. Computes aggregates, shows the plan, asks
# for confirmation, runs the write, prints the final summary.
apply_plan() {
    local dry_run="$1" no_confirm="$2"

    local commits commit_files skip_files
    read -r commits commit_files skip_files < <(plan_count_commits)

    if [[ $commits -eq 0 ]]; then
        tprintf '\nNothing to apply: all groups skipped.\n'
        return 0
    fi

    print_plan_block

    # Final confirmation (only in live interaction, not in dry-run).
    if [[ $no_confirm -eq 0 && $dry_run -eq 0 ]]; then
        local ans
        _t 'Apply the plan?'
        ans=$(prompt_yes_no "$T")
        if [[ "$ans" == "notty" ]]; then
            _tty_lost_err
            return 1
        fi
        if [[ "$ans" != "yes" ]]; then
            tprintf '\nCancelled. Nothing written.\n'
            return 0
        fi
    fi

    execute_plan "$dry_run"

    if [[ $dry_run -eq 0 ]]; then
        print_final_summary "$commit_files" "$skip_files"
    fi
    if [[ -n "$EXEC_FAILED_GROUPS" ]]; then
        errf 'exiftool failed in groups: %s; the other groups were processed' "$EXEC_FAILED_GROUPS"
        return 1
    fi
}

# Prints "commits commit_files skip_files" on one line.
plan_count_commits() {
    local g commits=0 commit_files=0 skip_files=0
    local groups=${#GROUP_SIG[@]}
    for ((g=0; g<groups; g++)); do
        if [[ "${GROUP_RESULT_STATUS[$g]}" == "commit" ]]; then
            commits=$((commits + 1))
            commit_files=$((commit_files + GROUP_COUNT[g]))
        else
            skip_files=$((skip_files + GROUP_COUNT[g]))
        fi
    done
    printf '%d %d %d\n' "$commits" "$commit_files" "$skip_files"
}

# Prints the summary "Write plan".
print_plan_block() {
    local groups=${#GROUP_SIG[@]} g
    tprintf '\n━━━ Write plan ━━━\n'
    group_table_widths plan
    group_table_header plan
    for ((g=0; g<groups; g++)); do
        format_group_line "$g" plan
    done

    # Tag preview for every committed group — details of the values that
    # will actually land in EXIF. It used to be shown inside the card, but
    # the card was slimmed down for reliable in-place redraw → details here.
    for ((g=0; g<groups; g++)); do
        if [[ "${GROUP_RESULT_STATUS[$g]}" == "commit" ]]; then
            local cam_idx=${GROUP_RESULT_CAM[$g]}
            local lens_idx=${GROUP_RESULT_LENS[$g]}
            if [[ $groups -gt 1 ]]; then
                printf '\n[%d] %s + %s\n' $((g+1)) \
                       "${CAM_DISPLAYS[$cam_idx]}" "${LENS_DISPLAYS[$lens_idx]}"
            fi
            _print_tag_preview_for "$cam_idx" "$lens_idx"
        fi
    done
}

# Draws one progress bar line "<prefix>[███░░] NN% (cur/total) fname"
# over the current one (ANSI_ERASE_LINE). Arguments: prefix, cur, total, file
# name, window width (0 — unknown, no truncation). Bar width —
# PROGRESS_BAR_WIDTH.
# The line must stay strictly narrower than the window: EL 2 + CR erase only
# the current physical line, and a wrapped bar would leave a tail on screen
# on every update. So a long name is truncated with "…", and in a
# narrow window the bar itself shrinks too (down to 10 cells).
_draw_progress() {
    local prefix="$1" cur="$2" total="$3" fname="$4" cols="$5"
    local bar_w=$PROGRESS_BAR_WIDTH
    local fixed avail pct filled empty fstr estr
    if (( cols > 0 )); then
        # prefix + "[" bar "] " + "NNN%" + " (cur/total) "
        fixed=$(( ${#prefix} + 1 + bar_w + 2 + 4 + 2 + ${#cur} + 1 + ${#total} + 2 ))
        avail=$((cols - 1 - fixed))
        if (( avail < 8 && bar_w > 10 )); then
            bar_w=$((bar_w - (8 - avail)))
            if (( bar_w < 10 )); then bar_w=10; fi
            fixed=$(( ${#prefix} + 1 + bar_w + 2 + 4 + 2 + ${#cur} + 1 + ${#total} + 2 ))
            avail=$((cols - 1 - fixed))
        fi
        if (( avail < 2 )); then
            fname=""
        elif (( ${#fname} > avail )); then
            fname="${fname:0:avail-1}…"
        fi
    fi
    pct=$((cur * 100 / total))
    filled=$((cur * bar_w / total))
    empty=$((bar_w - filled))
    # bash 3.2-compatible fill via printf -v and substitution.
    printf -v fstr '%*s' "$filled" ''
    printf -v estr '%*s' "$empty" ''
    fstr=${fstr// /█}
    estr=${estr// /░}
    printf '%s%s[%s%s] %3d%% (%d/%d) %s' \
           "$ANSI_ERASE_LINE" "$prefix" "$fstr" "$estr" "$pct" "$cur" "$total" "$fname"
}

# Runs exiftool with -progress and draws a single updating progress bar
# line (\r overprint). The serial output "======== file [N/M]"
# goes to exiftool's stdout — we parse and rewrite it.
#
# Non-progress exiftool lines (warnings, the final "N image files updated")
# are printed on a separate line without breaking the next step's bar.
#
# The original exiftool rc is returned via PIPESTATUS.
run_with_progress_bar() {
    # Arguments: everything goes to exiftool as is.
    local rc
    # Window width — once before the run (for truncating the bar line).
    _term_size
    local cols=$TERM_COLS

    exiftool -progress -q "$@" 2>&1 | {
        local cur=0 total=0 fname="" last_path=""
        while IFS= read -r line; do
            if [[ "$line" =~ ^========\ (.+)\ \[([0-9]+)/([0-9]+)\]$ ]]; then
                last_path="${BASH_REMATCH[1]}"
                fname=$(basename "$last_path")
                cur=${BASH_REMATCH[2]}
                total=${BASH_REMATCH[3]}
                _draw_progress "" "$cur" "$total" "$fname" "$cols"
            elif [[ -n "$line" ]]; then
                # A non-progress line (warning/error from exiftool or Perl).
                # Prefix it with the last file name from a progress event,
                # so it is visible which file has the problem — exiftool
                # does not print the path in warnings itself.
                if [[ -n "$fname" ]]; then
                    printf '%s[%s] %s\n' "$ANSI_ERASE_LINE" "$fname" "$line"
                else
                    printf '%s%s\n' "$ANSI_ERASE_LINE" "$line"
                fi
                # Append the path to the shared tmp list (dedup later, in
                # the parent via sort -u). A pipe subshell does not see the
                # parent's array changes — hence a file, not a variable.
                if [[ -n "$last_path" && -n "$WARNED_FILES_TMP" ]]; then
                    printf '%s\n' "$last_path" >> "$WARNED_FILES_TMP"
                fi
            fi
        done
        # Final newline after the last bar.
        printf '\n'
    }
    rc=${PIPESTATUS[0]}
    return "$rc"
}

# For each file with warnings, extracts the structural warnings
# via `exiftool -Warning -G1 -s` — the special Warning tag into
# which exiftool writes metadata parsing problems (Bad MakerNote,
# Invalid IFD entry, etc). If the tag is empty, the warning arose not while
# reading but during the write (inside exiftool); we give a hint for that.
print_warning_postmortem() {
    if [[ $# -eq 0 ]]; then
        return 0
    fi
    tprintf '\nWarning details:\n'
    local f w
    for f in "$@"; do
        # `-Warning -G1 -s` — only the Warning tag (no -all: that dumps
        # every tag).
        w=$(exiftool -Warning -G1 -s "$f" 2>/dev/null)
        if [[ -n "$w" ]]; then
            printf '  %s:\n' "$(basename "$f")"
            printf '%s\n' "$w" | sed 's/^/    /'
        else
            tprintf '  %s: no structural warnings in the file\n' \
                   "$(basename "$f")"
            # shellcheck disable=SC2016
            tprintf '    (exiftool warned while writing; the file was updated.\n'
            # shellcheck disable=SC2016
            tprintf '    Details: `exiftool -v "%s" 2>&1 | grep -B 3 -i warning`)\n' "$f"
        fi
    done
}

# Group numbers (1-based, joined by ", ") on which exiftool returned an error.
# Filled by execute_plan; such groups get GROUP_RESULT_STATUS=failed.
EXEC_FAILED_GROUPS=""

# Run over the groups: either exiftool or printing the command (dry-run).
# An exiftool error in one group does not stop the others: the group
# is marked failed and the run goes on (exiftool also continues within a
# group after a failed file). The error code is set by apply_plan.
# Changes the globals EXIFTOOL_ARGS, FILES_OF_GROUP, GROUP_RESULT_STATUS,
# EXEC_FAILED_GROUPS.
execute_plan() {
    local dry_run="$1"
    local groups=${#GROUP_SIG[@]} g
    EXEC_FAILED_GROUPS=""

    # Tmp file to which run_with_progress_bar appends problem paths.
    # Dedup via sort -u at the very end. A template with a path, not `-t`: BSD
    # mktemp -t keeps the X's in the name literally, GNU reads -t differently.
    trap _cleanup_tmp EXIT
    WARNED_FILES_TMP=$(mktemp "${TMPDIR:-/tmp}/glasser-warned.XXXXXX")

    # Ctrl-C during the write: exiftool catches SIGINT itself and exits with
    # code 1, so bash does not die and would go on writing the next groups.
    # Catch INT and stop after the current exiftool (the trap fires once
    # the foreground process has finished; children get the tty SIGINT
    # anyway). No trap in dry-run: there is nothing to write, and Ctrl-C must
    # kill the run at once (with a trap printing would go on with code 0, and
    # a killed $(shquote …) would leave an empty path).
    local interrupted=0
    [[ $dry_run -eq 1 ]] || trap 'interrupted=1' INT

    for ((g=0; g<groups; g++)); do
        [[ "${GROUP_RESULT_STATUS[$g]}" == "commit" ]] || continue
        local cam=${GROUP_RESULT_CAM[$g]} lens=${GROUP_RESULT_LENS[$g]}
        build_exiftool_args "$cam" "$lens"
        files_of_group "$g"
        # Ctrl-C between groups (also mid build_exiftool_args: a killed
        # $(equiv_focal …) would give an empty value and clear the tag) —
        # the next exiftool is not started.
        if [[ $interrupted -eq 1 ]]; then
            printf '\n' >&2
            errf 'interrupted (Ctrl-C) before group %d: it and the following ones are untouched' $((g+1))
            exit 130
        fi

        if [[ $dry_run -eq 1 ]]; then
            if [[ $groups -gt 1 ]]; then
                tprintf '\n# Group %d/%d (%s + %s):\n' \
                       $((g+1)) "$groups" \
                       "${CAM_DISPLAYS[$cam]}" "${LENS_DISPLAYS[$lens]}"
            else
                tprintf '\n--- dry-run, the command is not executed: ---\n'
            fi
            print_dry_run "${FILES_OF_GROUP[@]}"
            continue
        fi

        if [[ $groups -gt 1 ]]; then
            tprintf '\nRunning exiftool for group %d/%d...\n' $((g+1)) "$groups"
        else
            tprintf '\nRunning exiftool...\n'
        fi

        # Path list via `-@ argfile` — works around ARG_MAX.
        # Progress: by default draw the bar (a single updating line).
        # With --verbose or in non-TTY — serial "======== file [N/M]".
        # Safety net for -@: a line not starting with '/', or a path with a
        # newline would become a comment or an option in the argfile.
        # scan_and_group lets nothing like that through — an invariant check.
        local f
        for f in "${FILES_OF_GROUP[@]}"; do
            case "$f" in
                /*$'\n'*|/*$'\r'*) dief 'path with a newline: %s' "$f" ;;
                /*) ;;
                *) dief 'path is not absolute: %s' "$f" ;;
            esac
        done
        ARGFILE=$(mktemp "${TMPDIR:-/tmp}/glasser-files.XXXXXX")
        printf '%s\n' "${FILES_OF_GROUP[@]}" > "$ARGFILE"
        local rc=0
        # The bar only where cards work (TTY, not TERM=dumb, the terminal
        # answers): otherwise ANSI line erasing would leak into the output.
        if [[ $VERBOSE_PROGRESS -eq 1 || $USE_CARDS -eq 0 ]]; then
            exiftool -progress "${EXIFTOOL_ARGS[@]}" -@ "$ARGFILE" || rc=$?
        else
            run_with_progress_bar "${EXIFTOOL_ARGS[@]}" -@ "$ARGFILE" || rc=$?
        fi
        rm -f "$ARGFILE"
        ARGFILE=""
        if [[ $interrupted -eq 1 ]]; then
            # A newline so the message does not land on a half-drawn bar.
            printf '\n' >&2
            errf 'interrupted (Ctrl-C) in group %d: it may be partly written, the following ones are untouched' $((g+1))
            exit 130
        fi
        if [[ $rc -ne 0 ]]; then
            GROUP_RESULT_STATUS[g]="failed"
            EXEC_FAILED_GROUPS="${EXEC_FAILED_GROUPS:+$EXEC_FAILED_GROUPS, }$((g+1))"
            errf 'exiftool failed (group %d)' $((g+1))
        fi
    done
    trap - INT

    # Post-mortem: unique paths from the tmp file. If there were no warnings,
    # the file is empty and print_warning_postmortem gets 0 arguments.
    local warned=()
    if [[ -s "$WARNED_FILES_TMP" ]]; then
        local f
        while IFS= read -r f; do
            warned+=("$f")
        done < <(sort -u "$WARNED_FILES_TMP")
    fi
    rm -f "$WARNED_FILES_TMP"
    WARNED_FILES_TMP=""
    if [[ ${#warned[@]} -gt 0 ]]; then
        print_warning_postmortem "${warned[@]}"
    fi
}

# Final summary after the write. Groups with an exiftool error (failed)
# are shown separately: some of their files may have been written — exiftool
# writes file by file.
print_final_summary() {
    local commit_files="$1" skip_files="$2"
    local groups=${#GROUP_SIG[@]} g
    local failed_files=0
    for ((g=0; g<groups; g++)); do
        if [[ "${GROUP_RESULT_STATUS[$g]}" == "failed" ]]; then
            failed_files=$((failed_files + GROUP_COUNT[g]))
        fi
    done
    local ok_files=$((commit_files - failed_files))

    if [[ $failed_files -eq 0 ]]; then
        printf '\n'
        shutter_click
        tprintf '✓ Done.\n'
    else
        tprintf '\n✗ Done with errors.\n'
    fi
    if [[ $groups -gt 1 ]]; then
        group_table_widths final
        group_table_header final
        for ((g=0; g<groups; g++)); do
            format_group_line "$g" final
        done
        tprintf '\nTotal: %d %s tagged' "$ok_files" "$(files_word "$ok_files")"
        if [[ $failed_files -gt 0 ]]; then
            tprintf ', %d %s failed (some may be partly written)' \
                   "$failed_files" "$(files_word "$failed_files")"
        fi
        if [[ $skip_files -gt 0 ]]; then
            tprintf ', %d %s skipped' "$skip_files" "$(files_word "$skip_files")"
        fi
        printf '.\n\n'
    else
        local cam=${GROUP_RESULT_CAM[0]}
        local lens=${GROUP_RESULT_LENS[0]}
        local key_w k_done k_failed k_cam k_lens
        _t 'Tagged:'; k_done=$T
        _t 'Failed:'; k_failed=$T
        _t 'Camera:'; k_cam=$T
        _t 'Lens:';   k_lens=$T
        _max_len "$k_done" "$k_failed" "$k_cam" "$k_lens"
        key_w=$MAX_LEN
        if [[ $failed_files -eq 0 ]]; then
            printf '  %s %d %s\n' "$(pad "$k_done" "$key_w")" \
                   "$commit_files" "$(files_word "$commit_files")"
        else
            tprintf '  %s %d %s (some may be partly written)\n' \
                   "$(pad "$k_failed" "$key_w")" \
                   "$failed_files" "$(files_word "$failed_files")"
        fi
        printf '  %s %s\n'    "$(pad "$k_cam" "$key_w")" "${CAM_DISPLAYS[$cam]}"
        printf '  %s %s\n'    "$(pad "$k_lens" "$key_w")" "${LENS_DISPLAYS[$lens]}"
    fi
}

main "$@"
